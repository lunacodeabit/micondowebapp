rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ===========================================
    // ⚠️ DEVELOPMENT MODE - OPEN RULES
    // TODO: Restore storage.rules.backup before going to production!
    // ===========================================
    
    // Allow all read/write operations during development
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
