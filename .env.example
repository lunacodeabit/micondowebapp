# ===========================================
# MI CONDO - Environment Variables Template
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
# Get these values from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ===========================================
# SUPER ADMIN CONFIGURATION
# ===========================================
# The Firebase Auth UID of the super admin user
# This user will have access to manage all companies
# Get this from Firebase Console > Authentication > Users
VITE_SUPER_ADMIN_UID=your_super_admin_uid_here

# ===========================================
# APP CONFIGURATION (Optional)
# ===========================================
VITE_APP_ENV=development
