rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===========================================
    // ⚠️ DEVELOPMENT MODE - OPEN RULES
    // TODO: Restore firestore.rules.backup before going to production!
    // ===========================================
    
    // Allow all read/write operations during development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
